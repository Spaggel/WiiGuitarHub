<Application x:Class="WiiHub.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WiiHub.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Palette -->
            <SolidColorBrush x:Key="WindowBg" Color="#F3F4F7" />
            <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EB" />
            <SolidColorBrush x:Key="TextBrush" Color="#1D2129" />
            <SolidColorBrush x:Key="SubtleText" Color="#6B7280" />
            <SolidColorBrush x:Key="Accent" Color="#3B6FF5" />
            <SolidColorBrush x:Key="AccentSoft" Color="#E8EEFE" />
            <SolidColorBrush x:Key="Danger" Color="#D93F45" />
            <SolidColorBrush x:Key="Ok" Color="#2EB872" />
            <SolidColorBrush x:Key="PillOff" Color="#EEF0F4" />
            <SolidColorBrush x:Key="Warning" Color="#FFF4E0" />

            <SolidColorBrush x:Key="FretGreen" Color="#2DBE60" />
            <SolidColorBrush x:Key="FretRed" Color="#E5484D" />
            <SolidColorBrush x:Key="FretYellow" Color="#F5C400" />
            <SolidColorBrush x:Key="FretBlue" Color="#2F80ED" />
            <SolidColorBrush x:Key="FretOrange" Color="#F2853A" />

            <!-- Converters -->
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <local:BoolToOpacityConverter x:Key="LitOpacity" />
            <local:BoolToOpacityConverter x:Key="DimWhenFalse" On="1" Off="0.45" />
            <local:BoolToBrushConverter x:Key="PillBrush" On="#3B6FF5" Off="#EEF0F4" />
            <local:BoolToBrushConverter x:Key="PillText" On="#FFFFFF" Off="#4B5563" />
            <local:BoolToBrushConverter x:Key="ActiveRowBrush" On="#E8EEFE" Off="#FFFFFF" />
            <local:BoolToBrushConverter x:Key="ActiveDotBrush" On="#3B6FF5" Off="#D9DDE4" />
            <local:BoolToBrushConverter x:Key="StatusDot" On="#2EB872" Off="#B8BEC8" />
            <local:BoolToBrushConverter x:Key="LedBrush" On="#3B6FF5" Off="#D9DDE4" />
            <local:BoolToBrushConverter x:Key="StarPowerBrush" On="#3B6FF5" Off="#EEF0F4" />
            <local:AxisToOffsetConverter x:Key="AxisToOffset" />
            <local:BatteryToBrushConverter x:Key="BatteryBrush" />
            <local:HexToBrushConverter x:Key="HexBrush" />

            <!-- No implicit TextBlock style on purpose: it would override the foreground that
                 buttons pass on to their content. Windows set Foreground instead. -->

            <!-- Windows' built-in icon font: Segoe Fluent Icons (Windows 11), Segoe MDL2 Assets (Windows 10). -->
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

            <!-- Cards -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>

            <!-- Buttons -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3B6FF5" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,8" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="{StaticResource Danger}" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,18,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="Background" Value="{StaticResource PillOff}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- A small rounded indicator that lights up when its input is pressed.
                 Bind Tag to the bool; the template turns it blue. -->
            <Style x:Key="Pill" TargetType="ContentControl">
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border CornerRadius="8" Padding="8,0"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PillBrush}}">
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PillText}}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tabs -->
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
