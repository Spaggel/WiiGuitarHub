<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area (tray) icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF0001: Application.ThemeMode (Fluent theme, used for dark mode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WiiHub.App</RootNamespace>
    <AssemblyName>WiiHub</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Product>Wii Guitar Hub</Product>
    <ApplicationIcon>Assets\wii-guitar-hub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\wii-guitar-hub.ico" />
    <Resource Include="Assets\wii-guitar-hub.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing out of the global usings: their Application, MessageBox, Color, … would
         clash with the WPF types of the same name. Files that need them import them explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Talks to the ViGEmBus driver (virtual Xbox 360 controllers). -->
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WiiHub.Core\WiiHub.Core.csproj" />
    <ProjectReference Include="..\WiiHub.ViewModels\WiiHub.ViewModels.csproj" />
  </ItemGroup>

</Project>
