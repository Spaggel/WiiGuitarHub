<UserControl x:Class="WiiHub.App.Views.WiimotePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="5" Text="Wiimote" Style="{StaticResource SectionTitle}" />

            <!-- D-pad -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Grid.Column="1" Grid.Row="0" Style="{StaticResource Pill}" Content="▲" Tag="{Binding WmUp}" />
                <ContentControl Grid.Column="0" Grid.Row="1" Style="{StaticResource Pill}" Content="◀" Tag="{Binding WmLeft}" />
                <ContentControl Grid.Column="2" Grid.Row="1" Style="{StaticResource Pill}" Content="▶" Tag="{Binding WmRight}" />
                <ContentControl Grid.Column="1" Grid.Row="2" Style="{StaticResource Pill}" Content="▼" Tag="{Binding WmDown}" />
            </Grid>

            <!-- Face buttons -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Pill}" Content="A" Tag="{Binding WmA}" />
                    <ContentControl Style="{StaticResource Pill}" Content="B" Tag="{Binding WmB}" ToolTip="Trigger on the back" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Pill}" Content="−" Tag="{Binding WmMinus}" />
                    <ContentControl Style="{StaticResource Pill}" Content="HOME" Tag="{Binding WmHome}" />
                    <ContentControl Style="{StaticResource Pill}" Content="+" Tag="{Binding WmPlus}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Pill}" Content="1" Tag="{Binding WmOne}" />
                    <ContentControl Style="{StaticResource Pill}" Content="2" Tag="{Binding WmTwo}" />
                </StackPanel>
            </StackPanel>

            <!-- Accelerometer -->
            <Grid Grid.Row="1" Grid.Column="4" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="Motion (−1 g … +1 g)" Style="{StaticResource Caption}" Margin="0,4,0,8" />
                <TextBlock Grid.Row="1" Text="X" Style="{StaticResource Caption}" Margin="0,0,10,8" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Maximum="100" Value="{Binding AccelX, Mode=OneWay}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Text="Y" Style="{StaticResource Caption}" Margin="0,0,10,8" />
                <ProgressBar Grid.Row="2" Grid.Column="1" Maximum="100" Value="{Binding AccelY, Mode=OneWay}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="3" Text="Z" Style="{StaticResource Caption}" Margin="0,0,10,8" />
                <ProgressBar Grid.Row="3" Grid.Column="1" Maximum="100" Value="{Binding AccelZ, Mode=OneWay}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="With a guitar plugged in, the Wiimote's motion sensor is what detects tilt." />
            </Grid>
        </Grid>
    </Border>
</UserControl>
