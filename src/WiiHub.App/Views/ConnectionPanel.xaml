<UserControl x:Class="WiiHub.App.Views.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WiiHub.App.Views">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" />
                <views:SignalBars Bars="{Binding SignalBars}" Color="{Binding SignalColor}" Margin="0,0,6,10" />
                <TextBlock Text="{Binding SignalText}" FontWeight="SemiBold" Margin="0,0,0,10" VerticalAlignment="Center"
                           Foreground="{Binding SignalColor, Converter={StaticResource HexBrush}}" />
            </StackPanel>

            <WrapPanel>
                <TextBlock Text="{Binding LinkRateText}" Style="{StaticResource Caption}" Margin="0,0,18,4" />
                <TextBlock Text="{Binding LinkDropoutsText}" Style="{StaticResource Caption}" Margin="0,0,18,4" />
                <TextBlock Text="{Binding LinkResponseText}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
            </WrapPanel>

            <TextBlock TextWrapping="Wrap" Margin="0,10,0,8" Foreground="{DynamicResource TextBrush}"
                       Text="Range test: stand or sit where you normally play, hold the guitar as you would while playing, and start the test. It takes 20 seconds." />

            <StackPanel Orientation="Horizontal">
                <Button Content="Run range test" Command="{Binding RangeTestCommand}" Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelRangeTestCommand}"
                        Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Running -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}">
                <ProgressBar Maximum="100" Value="{Binding TestProgress, Mode=OneWay}" Height="8" />
                <TextBlock Text="{Binding TestStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Result -->
            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{Binding TestResultColor, Converter={StaticResource HexBrush}}"
                    Background="{Binding TestResultColor, Converter={StaticResource HexBrush}, ConverterParameter=0.12}"
                    Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding TestResultTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding TestResultDetails}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TestResultAdvice}" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasTestAdvice, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
