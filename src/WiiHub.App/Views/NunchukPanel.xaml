<UserControl x:Class="WiiHub.App.Views.NunchukPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Nunchuk" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal">
                <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource PillOff}" Margin="0,0,24,0">
                    <Canvas Width="76" Height="76">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource Accent}"
                                 Canvas.Left="{Binding NunchukStickX, Converter={StaticResource AxisToOffset}, ConverterParameter=60}"
                                 Canvas.Top="{Binding NunchukStickY, Converter={StaticResource AxisToOffset}, ConverterParameter=-60}" />
                    </Canvas>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Pill}" Content="C" Tag="{Binding NunchukC}" />
                    <ContentControl Style="{StaticResource Pill}" Content="Z" Tag="{Binding NunchukZ}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
