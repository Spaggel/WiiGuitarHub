<Window x:Class="WiiHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WiiHub.App.Views"
        Title="Wii Guitar Hub — Wiimotes &amp; Guitar Hero guitars"
        Icon="Assets/wii-guitar-hub.ico"
        Width="1220" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Sidebar ============================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/wii-guitar-hub.png" Width="40" Height="40" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Wii Guitar Hub logo" />
                        <TextBlock Text="Wii Guitar Hub" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Wiimotes &amp; Guitar Hero guitars on your PC" Style="{StaticResource Caption}" Margin="0,2,0,14" />
                    <Button Content="+  Pair a Wiimote" Command="{Binding PairCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                    <Grid Margin="0,20,0,6">
                        <TextBlock Text="CONTROLLERS" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Command="{Binding TurnOffAllCommand}" HorizontalAlignment="Right"
                                Padding="8,3" FontSize="12"
                                ToolTip="Switch off every connected Wiimote. They stay paired: press a button to turn one on again." >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Margin="0,1,6,0" />
                                <TextBlock Text="Turn off all" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Status of the drivers at the bottom of the sidebar -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,16">
                    <TextBlock Text="TURN OFF IDLE WIIMOTES" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding AutoOffOptions}" SelectedValuePath="Value" DisplayMemberPath="Name"
                              SelectedValue="{Binding AutoOffMinutes}" Margin="0,4,0,14"
                              ToolTip="Saves batteries: a Wiimote nobody touched for this long is switched off. Press a button to turn it on again." />
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,6"
                              ToolTip="Start Wii Guitar Hub automatically when you log in. Handy for a dedicated Clone Hero / YARG PC." />
                    <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="20,0,0,14"
                              IsEnabled="{Binding StartWithWindows}"
                              ToolTip="When started with Windows, keep the window minimized on the taskbar." />
                    <TextBlock Text="BLUETOOTH" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BluetoothStatus}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,2,0,10" />
                    <TextBlock Text="XBOX 360 OUTPUT" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding XboxStatus}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <TextBlock Margin="0,4,0,0" Visibility="{Binding XboxAvailable, Converter={StaticResource InverseBoolToVis}}">
                        <Hyperlink NavigateUri="https://github.com/nefarius/ViGEmBus/releases" RequestNavigate="Hyperlink_RequestNavigate">Download ViGEmBus</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <Grid>
                    <TextBlock Text="No controllers yet. Click “Pair a Wiimote” to add one."
                               TextWrapping="Wrap" Margin="18,4" Style="{StaticResource Caption}"
                               Visibility="{Binding HasNoControllers, Converter={StaticResource BoolToVis}}" />

                    <ListBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding Selected}" MouseDoubleClick="ControllerList_MouseDoubleClick"
                             BorderThickness="0" Background="Transparent" Padding="10,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="9" Padding="12,10" Background="Transparent"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" ToolTip="{Binding HardwareText}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename…" InputGestureText="F2" Click="RenameMenuItem_Click" />
                                            <MenuItem Header="Identify (rumble)" Command="{Binding IdentifyCommand}" />
                                            <MenuItem Header="Turn off" Command="{Binding TurnOffCommand}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Fill="{Binding IsConnected, Converter={StaticResource StatusDot}}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </StackPanel>

                                    <!-- Player LEDs, like on the Wiimote -->
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding LedPattern}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="7" Height="7" CornerRadius="2" Margin="2,0"
                                                        Background="{Binding Converter={StaticResource LedBrush}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="17,3,0,0" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ExtensionText, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding BatteryText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="17,2,0,0" Style="{StaticResource Caption}"
                                               Text="{Binding StatusText}" TextWrapping="Wrap"
                                               Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================== Main area ============================== -->
        <Grid Grid.Column="1">

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Connect your first Wiimote" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,18" Foreground="{StaticResource SubtleText}"
                           Text="Click “Pair a Wiimote”, then press the red SYNC button under the battery cover. After that the Wiimote reconnects on its own whenever you press a button — also after changing batteries. Plug your Guitar Hero guitar into the Wiimote and it is detected automatically." />
                <Button Content="+  Pair a Wiimote" Command="{Binding PairCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
            </StackPanel>

            <DockPanel DataContext="{Binding Selected}" Margin="22,18,22,14"
                       Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                <!-- Header -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <!-- Label: shown as a title, with a Rename button (also F2 / double-click in the list) -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="460" Foreground="{StaticResource TextBrush}" />
                                    <Button Content="✎  Rename" Command="{Binding StartRenameCommand}" Margin="12,0,0,0"
                                            Padding="10,4" VerticalAlignment="Center" ToolTip="Give this Wiimote a name, e.g. “Red guitar” (F2)" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                    <Grid Width="340">
                                        <TextBox x:Name="RenameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="18" FontWeight="SemiBold" MaxLength="40"
                                                 BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2" Background="Transparent"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <!-- Placeholder while the box is empty -->
                                        <TextBlock Text="{Binding NamePlaceholder}" IsHitTestVisible="False" Margin="4,0,0,2"
                                                   VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=RenameBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Content="Save" Command="{Binding CommitRenameCommand}" Style="{StaticResource PrimaryButton}" Focusable="False"
                                            Padding="12,5" Margin="10,0,6,0" VerticalAlignment="Center" />
                                    <Button Content="Cancel" Command="{Binding CancelRenameCommand}" Focusable="False" Padding="10,5" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                    <Run Text="{Binding StatusText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ExtensionText, Mode=OneWay}" />
                                    <Run Text=" · Battery " />
                                    <Run Text="{Binding BatteryText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding HardwareText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Identify" Command="{Binding IdentifyCommand}" Margin="0,0,6,0"
                                        ToolTip="Rumble this Wiimote so you know which one it is" />
                                <Button Command="{Binding TurnOffCommand}" Margin="0,0,6,0"
                                        ToolTip="Switch this Wiimote off. It stays paired: press any button to turn it on again." >
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Margin="0,1,6,0" />
                                        <TextBlock Text="Turn off" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Repair connection" Command="{Binding RepairCommand}" Margin="0,0,6,0"
                                        ToolTip="Re-enable the Bluetooth HID service. Try this if the Wiimote is paired but never connects." />
                                <Button Content="Forget" Command="{Binding ForgetCommand}" Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,14,0,0">
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Text="Shows up as" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                <ComboBox Width="200" ItemsSource="{Binding OutputModeOptions}" SelectedValuePath="Value" DisplayMemberPath="Name"
                                          SelectedValue="{Binding OutputMode}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Text="Player (LEDs)" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                <ComboBox Width="120" ItemsSource="{Binding PlayerOptions}" SelectedValuePath="Value" DisplayMemberPath="Name"
                                          SelectedValue="{Binding PlayerIndex}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox Content="Forward rumble" IsChecked="{Binding ForwardRumble}"
                                          ToolTip="Games can rumble the Wiimote through the virtual Xbox controller" />
                                <CheckBox Content="Keep Xbox controller during battery swap" IsChecked="{Binding KeepVirtualPad}"
                                          ToolTip="The game keeps the same player slot while the Wiimote is briefly gone" />
                                <CheckBox Content="Touch bar as frets" IsChecked="{Binding TouchBarEnabled}"
                                          ToolTip="Guitar Hero World Tour slider bar (ignored on GH3 guitars)" />
                            </StackPanel>
                        </WrapPanel>

                        <Border Background="{StaticResource Warning}" CornerRadius="7" Padding="10,7" Margin="0,4,0,0"
                                Visibility="{Binding HasOutputError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding OutputError}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <TabControl Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
                    <TabItem Header="Input check">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <views:GuitarPanel Visibility="{Binding IsGuitar, Converter={StaticResource BoolToVis}}" />
                                <views:WiimotePanel />
                                <views:NunchukPanel Visibility="{Binding IsNunchuk, Converter={StaticResource BoolToVis}}" />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="What the PC receives" Style="{StaticResource SectionTitle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Xbox 360 controller" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Column="1" Text="{Binding XboxOutputText}" FontFamily="Consolas" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Text="Keyboard" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KeysOutputText}" FontFamily="Consolas" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Text="Raw" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RawText}" FontFamily="Consolas" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Button mapping">
                        <views:MappingPanel />
                    </TabItem>

                    <TabItem Header="Log">
                        <Border Style="{StaticResource Card}" Padding="0">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="10" Content="Clear"
                                        Command="{Binding DataContext.ClearLogCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="6"
                                         ItemsSource="{Binding DataContext.LogLines, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DockPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
