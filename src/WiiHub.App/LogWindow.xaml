<Window x:Class="WiiHub.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log — Wii Guitar Hub"
        Icon="Assets/wii-guitar-hub.ico"
        Width="820" Height="520" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="18">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Include this when you report a problem." Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy all" Click="CopyAll_Click" Margin="0,0,6,0"
                        ToolTip="Copy the whole log to the clipboard" />
                <Button Content="Clear" Command="{Binding ClearLogCommand}" Margin="0,0,6,0" />
                <Button Content="Close" Width="90" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="Consolas" FontSize="12" Padding="6" />
        </Border>
    </DockPanel>
</Window>
