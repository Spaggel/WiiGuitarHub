<Window x:Class="WiiHub.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="Assets/wii-guitar-hub.ico"
        Width="560" Height="640" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="18">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Changes are saved automatically." Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <Button Content="Close" HorizontalAlignment="Right" Width="90" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Focusable="False">
            <StackPanel x:Name="Sections">

                <!-- Appearance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Theme" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Value" DisplayMemberPath="Name"
                                  SelectedValue="{Binding Theme}" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="“Follow Windows” switches between light and dark together with Windows (Settings → Personalization → Colors)." />
                    </StackPanel>
                </Border>

                <!-- Power -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Saving batteries" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Turn off idle Wiimotes" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AutoOffOptions}" SelectedValuePath="Value" DisplayMemberPath="Name"
                                  SelectedValue="{Binding AutoOffMinutes}" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="A Wiimote nobody touched for this long is switched off. It stays paired: press any button to turn it on again." />
                    </StackPanel>
                </Border>

                <!-- Low battery -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Low battery" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding LowBatteryText}" Margin="0,0,0,6" />
                        <CheckBox Content="Show a Windows notification" IsChecked="{Binding LowBatteryNotify}" Margin="0,0,0,6" />
                        <CheckBox Content="Rumble the Wiimote (three short pulses)" IsChecked="{Binding LowBatteryRumble}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Each Wiimote warns once, and again only after new batteries ran low. While a fullscreen game runs, Windows' “Do not disturb” may hold notifications back until you leave the game; the rumble always comes through." />
                    </StackPanel>
                </Border>

                <!-- Tray -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Notification area (tray)" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Minimize to the tray" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,6" />
                        <CheckBox Content="Close button keeps it running in the tray" IsChecked="{Binding CloseToTray}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Your controllers keep working while the window is hidden. Click the tray icon to open the window; right-click it to see your controllers, turn them all off, or exit." />
                    </StackPanel>
                </Border>

                <!-- Startup -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Startup" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,6" />
                        <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="22,0,0,0"
                                  IsEnabled="{Binding StartWithWindows}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Handy for a dedicated Clone Hero / YARG PC: Wii Guitar Hub starts when you log in, and your guitars connect as soon as you press a button. With “Minimize to the tray” on, a minimized start goes straight to the tray." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
